#!/usr/bin/env bash
set -euo pipefail

# https://github.com/morganamilo/paru#installation
sudo pacman -S --needed --noconfirm base-devel
git clone https://aur.archlinux.org/paru.git paru
cd paru
makepkg -si

rm -rf paru

paru -S --needed --noconfirm blesh-git

sudo pacman -S --needed --noconfirm firefox fd ripgrep starship zoxide neovim vim trash-cli yazi \
  brightnessctl jq make nodejs npm power-profiles-daemon vlc \
  copyq wl-clipboard \
  grim slurp satty \
  noto-fonts noto-fonts-emoji noto-fonts-cjk noto-fonts-extra ttf-jetbrains-mono-nerd \
  git github-cli lazygit

# Set the charge type to Long_Life mode ( 80% threshold )
# https://linrunner.de/tlp/installation/arch.html
# https://linrunner.de/tlp/settings/bc-vendors.html#lenovo-non-thinkpad-series
# https://linrunner.de/tlp/settings/battery.html#start-stop-charge-thresh-batx
sudo pacman -S --needed --noconfirm tlp
sudoedit /etc/tlp.conf

sudo pacman -S --needed --noconfirm man-db man-pages
sudo man-db

# ========================

git clone https://github.com/iqrar-eng/archlinux ~/archlinux

paths=(
  ".bash_profile"
  ".bashrc"
  ".blerc"
  ".gitconfig"

  ".config/copyq/copyq-commands.ini"
  ".config/copyq/copyq.conf"
  ".config/dunst"
  ".config/hypr"
  ".config/kitty"
  ".config/nvim"
  ".config/rofi"
  ".config/systemd"
  ".config/yazi"
  ".config/tmux/tmux.conf"
  ".config/mimeapps.list"
  ".config/starship.toml"

  # https://github.com/boydaihungst/xdg-desktop-portal-termfilechooser/#configuration
  ".config/xdg-desktop-portal-termfilechooser"
  ".config/xdg-desktop-portal"

  ".local/share/applications"
)

# restore
# ========================

for p in "${paths[@]}"; do
  rm -rf "$HOME/$p"
  mkdir -p "$HOME/$(dirname "$p")" "$HOME/archlinux/$(dirname "$p")"
  ln -sfn "$HOME/archlinux/$p" "$HOME/$p"
done

sudo rm -rf "/etc/keyd/default.conf"
sudo mkdir -p /etc/keyd
sudo ln -sfn "$HOME/archlinux/etc/keyd/default.conf" "/etc/keyd/default.conf"

update-desktop-database "$HOME/.local/share/applications/"
xdg-mime default yazi.desktop inode/directory
systemctl --user restart xdg-desktop-portal-termfilechooser.service
systemctl --user restart xdg-desktop-portal.service

sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
sudo tee /etc/systemd/system/getty@tty1.service.d/override.conf > /dev/null << 'EOF'
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin iqrar --noclear %I $TERM
EOF
sudo systemctl daemon-reload
sudo systemctl restart getty@tty1
loginctl terminate-user $USER

# ========================

mkdir -p "$HOME/.src"

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/prisma/web.git prisma
git -C "$HOME/.src/prisma" sparse-checkout set --no-cone \
  'apps/docs/content/docs/**/*.mdx' \
  '!apps/docs/content/docs/**/v6/**'
git -C "$HOME/.src/prisma" checkout

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/better-auth/better-auth.git better-auth
git -C "$HOME/.src/better-auth" sparse-checkout set --no-cone \
  'docs/content/docs/**/*.mdx'
git -C "$HOME/.src/better-auth" checkout

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/vercel/next.js.git next.js
git -C "$HOME/.src/next.js" sparse-checkout set --no-cone \
  'docs/01-app'
git -C "$HOME/.src/next.js" checkout

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/nodejs/node.git node
git -C "$HOME/.src/node" sparse-checkout set --no-cone \
  'doc/api'
git -C "$HOME/.src/node" checkout

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/mdn/content.git mdn
git -C "$HOME/.src/mdn" sparse-checkout set --no-cone \
  'files/en-us/web/api' \
  'files/en-us/web/http' \
  'files/en-us/web/javascript'
git -C "$HOME/.src/mdn" checkout

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/reactjs/react.dev.git react
git -C "$HOME/.src/react" sparse-checkout set --no-cone \
  'src/content/reference'
git -C "$HOME/.src/react" checkout

git -C "$HOME/.src" clone --filter=blob:none --no-checkout https://github.com/typescript-cheatsheets/react.git typescript-cheatsheets-react
git -C "$HOME/.src/typescript-cheatsheets-react" sparse-checkout set --no-cone \
  'docs'
git -C "$HOME/.src/typescript-cheatsheets-react" checkout
rm "$HOME/.src/react/src/content/reference/_basic"
rm "$HOME/.src/react/src/content/reference/_api"
ln -s "$HOME/.src/typescript-cheatsheets-react/docs/basic/getting-started/" "$HOME/.src/react/src/content/reference/_basic"
ln -s "$HOME/.src/typescript-cheatsheets-react/docs/reference/" "$HOME/.src/react/src/content/reference/_api"
