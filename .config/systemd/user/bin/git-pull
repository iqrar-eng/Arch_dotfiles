#!/usr/bin/env bash

roots=(
  # ~/projects
  ~/.src
)
find "${roots[@]}" -name .git -type d -print0 | while IFS= read -r -d '' d; do
  repo="${d%/.git}"
  echo "==> $repo"
  git -C "$repo" fetch origin
  git -C "$repo" reset --hard "origin/$(git -C "$repo" symbolic-ref --short HEAD)"
  git -C "$repo" pull
done
