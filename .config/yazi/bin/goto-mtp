#!/usr/bin/env bash

sub="$1"

mtp="$(find "$XDG_RUNTIME_DIR/gvfs" -maxdepth 1 -type d -name 'mtp:*' -print -quit)"
if [ -z "$mtp" ]; then
  ya emit notify --content="No MTP device mounted" --level="error"
  exit 1
fi

dir="$mtp${sub:+/$sub}"
if [ ! -e "$dir" ]; then
  ya emit notify --content="Path not found: $dir" --level="error"
  exit 1
fi

ya emit cd "$dir"
