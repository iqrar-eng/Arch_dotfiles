#!/usr/bin/env bash
set -euo pipefail

sources=(
  "$HOME/.config/starship.toml"
  "$HOME/.blerc"
  "$HOME/.bashrc"
  "$HOME/.bash_profile"
  # "$HOME/projects"
  # "$HOME/.src"
  # "$HOME/backup"
  "$HOME/.config/copyq"
  "$HOME/.config/scripts"
  # "$HOME/.ssh"
  "$HOME/.config/tmux/tmux.conf"
  "$HOME/.config/kitty"
  "$HOME/.config/mimeapps.list"
  "$HOME/.config/nvim"
)

for src in "${sources[@]}"; do
  if [[ ! -e "$src" && ! -L "$src" ]]; then
    echo "skip (not found): $src"
    continue
  fi
  if [[ -L "$src" ]]; then
    echo "already linked, skip: $src"
    continue
  fi
  if [[ "$src" == "$HOME"/* ]]; then
    rel="${src#$HOME/}"
  else
    rel="${src#/}"
  fi
  dest="$DOTFILES/$rel"
  mkdir -p "$(dirname "$dest")"
  mv "$src" "$dest"
  ln -sfn "$dest" "$src"
  echo "linked: $src -> $dest"
done

# keyd needs sudo separately since /etc isn't user-writable
if [[ -e /etc/keyd/default.conf && ! -L /etc/keyd/default.conf ]]; then
    sudo mv /etc/keyd/default.conf "$DOTFILES/etc/keyd/default.conf"
    sudo chown "$USER:$USER" "$DOTFILES/etc/keyd/default.conf"
    sudo ln -sfn "$DOTFILES/etc/keyd/default.conf" /etc/keyd/default.conf
    echo "linked: /etc/keyd/default.conf -> $DOTFILES/etc/keyd/default.conf"
else
    echo "skip (already linked or missing): /etc/keyd/default.conf"
fi

echo "Backup complete: $DOTFILES"
